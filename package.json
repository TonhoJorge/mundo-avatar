{
  "name": "mundo-avatar",
  "version": "0.1.0",
  "private": true,
  "description": "Globo interativo do Mundo Avatar (projeto de fã, sem fins lucrativos)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/check-data.mjs && vite build",
    "preview": "vite preview",
    "check": "node tools/check-data.mjs",
    "tiles": "node tools/render-world.mjs",
    "tiles:rapido": "node tools/render-world.mjs --max-zoom 3 --field 4096",
    "glyphs": "node tools/build-glyphs.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "maplibre-gl": "6.16.0"
  },
  "devDependencies": {
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/marcellus-sc": "5.3.0",
    "@mapbox/tiny-sdf": "2.3.0",
    "sharp": "0.35.5",
    "vite": "8.3.8"
  }
}
